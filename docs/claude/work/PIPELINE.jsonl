og.json')); items=d['items'] if isinstance(d, dict) else d; print(json.dumps(next(i for i in items if i.get('id')=='BL-20260810-EXIT-LEVER-SPACE-UNDER-ENUMERATED'), indent=2))\""}, "state": "queued", "what": "[health] the coverage matrix's 8 lever columns are not the lever space: 21 exit-relevant harness flags exist, 3 have no column at all, and the operator's near-TP-reversal case has NO lever anywhere"}
