# ============================================
# ICT R4 RESEARCH→RESULTS GATE REPORTER (observe-only) — R4 P1
# Fires scripts/ops/run_research_results_gate.sh once a day: computes the
# per-leg measured-net (totalPnlMeasured / pnlCoverage) verdict over the live
# journal and writes the observe-only report under runtime_logs. NOTHING is
# enforced — this is the R4 evidence trail (design §6 P1); the enforcing flip
# is Tier-3 (P2).
# Save to: /etc/systemd/system/ict-research-results-gate.service
# ============================================

[Unit]
Description=ICT R4 research→results gate reporter (observe-only measured-net verdict per leg)
After=network.target ict-trader-live.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/ict-trading-bot
# Tolerate a missing .env on a fresh bootstrap (mirrors ict-git-sync.service).
EnvironmentFile=-/home/ubuntu/ict-trading-bot/.env
Environment=PYTHONPATH=/home/ubuntu/ict-trading-bot
# The reporter resolves the canonical DATA_DIR journal + writes under the
# DATA_DIR-aware runtime_logs; install_systemd_units.sh drops a data-dir.conf
# so this oneshot inherits DATA_DIR (same writer/reader-split fix as
# ict-hourly-snapshot / ict-db-integrity).
ExecStart=/home/ubuntu/ict-trading-bot/scripts/ops/run_research_results_gate.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
