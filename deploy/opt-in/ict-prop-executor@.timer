# Per-account prop executor timer (TRADEIFY-EXECUTOR, 2026-10-03). OPT-IN:
# installed and enabled only by
# `breakout-login-check account: <id> apply: executor-enable-timer`.
# :03/5 — two minutes after the same account's feed (ict-prop-feed@, :01/5), so
# that feed has usually released accounts/<id>/login.lock and left a fresh saved
# session (the same 2-minute gap breakout_1 has, :02 feed -> :04 executor). It is
# off breakout_1's feed (:02/5) and real-money executor (:04/5) slots; the locks
# are separate anyway, so a collision never skips a breakout_1 tick, and a busy
# accounts/<id>/login.lock skips this tick, never queues it.
[Unit]
Description=Trigger ict-prop-executor@%i every 5 minutes (%i)

[Timer]
OnCalendar=*-*-* *:03/5:00
AccuracySec=15s
Persistent=false
Unit=ict-prop-executor@%i.service

[Install]
WantedBy=timers.target
