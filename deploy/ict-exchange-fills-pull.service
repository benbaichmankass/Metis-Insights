# ============================================
# ICT EXCHANGE-FILLS PULL (BL-20260713-EXCHANGE-FILLS-STORE-EMPTY)
# Refreshes runtime_state/exchange_fills.sqlite with the last 7 days of REAL
# Bybit fills for EVERY live Bybit account (bybit_1 / bybit_2 / bybit_portfolio,
# each category=linear — USDT-margined perps) so the exchange-truth P&L surface
# /api/bot/pnl/exchange + the broker-truth cost sweep have data for the whole
# roster instead of just bybit_2.
#
# Why this exists: the S-067 puller (scripts/pull_exchange_fills.py) shipped
# with NO timer and NO system-action, AND pulled the spot category only — so
# the fills store had never accrued a single row while bybit_2 traded linear
# perps daily (the 2026-07-13 health-review found /api/bot/pnl/exchange dark
# with 0 fills/7d). PR #6290 added --category linear + the on-demand
# pull-exchange-fills action; this unit makes the refresh durable so the
# surface doesn't go stale again the moment the on-demand run ages out of the
# 7-day window. Multi-account rollout (rec #7 broker-truth cost coverage,
# 2026-07-29): --all-bybit-accounts loops every live Bybit account from
# config/accounts.yaml (config-driven — a roster change needs no unit edit),
# each pulled with its own api_key_env credentials; fail-soft on a missing-cred
# account.
#
# LIVE-TRADER BOX ONLY. Reads Bybit over the public API using each account's
# BYBIT_API_KEY_* / BYBIT_API_SECRET_* from the trader .env; read-only on the
# exchange side (fetch_my_trades). Touches NO service and NO trade_journal.db
# table. The store's primary key is exec_id, so the hourly 7-day over-sampling is
# idempotent (duplicate fills are dropped).
#
# DATA_DIR: this unit MUST resolve runtime_state_dir() to the SAME root as
# ict-web-api (the reader) — /data/bot-data. Set explicitly below (mirrors
# ict-mes-ibkr-pull.service) so the writer and the API agree on
# $DATA_DIR/runtime_state/exchange_fills.sqlite; a writer/reader path-split
# would leave the endpoint empty (the ict-health-snapshot artifacts-path class
# of bug).
#
# Save to: /etc/systemd/system/ict-exchange-fills-pull.service
# (installed automatically by scripts/install_systemd_units.sh during
#  deploy_pull_restart.sh)
# ============================================

[Unit]
Description=ICT exchange-fills pull (Bybit + Alpaca) — keep /api/bot/pnl/exchange + broker-truth cost fresh (BL-20260713-EXCHANGE-FILLS-STORE-EMPTY)
After=network-online.target ict-trader-live.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/ict-trading-bot
# Load the trader .env for every Bybit account's creds (BYBIT_API_KEY_1/2/3 +
# their _SECRET_ pairs); --all-bybit-accounts resolves each account's env-var
# names from config/accounts.yaml::api_key_env.
EnvironmentFile=-/home/ubuntu/ict-trading-bot/.env
# Pin DATA_DIR so runtime_state_dir() resolves to the block-volume root the
# web-api reads from, regardless of whether .env carries it.
Environment=DATA_DIR=/data/bot-data
# Quick Bybit API call (~5s for a day's fills); cap generously for a slow
# session. A read/auth failure exits non-zero and the unit is marked failed —
# the next timer fire retries; no state is left half-written (exec_id PK).
TimeoutStartSec=300
# Run under the trader venv so ccxt imports (same interpreter the trader uses
# for Bybit) — not system /usr/bin/python3.
ExecStart=/home/ubuntu/ict-trading-bot/.venv/bin/python -u scripts/pull_exchange_fills.py --all-bybit-accounts --days 7
# Alpaca fills (rec #7): the same hourly timer also pulls every live Alpaca
# account's FILL activities (distinct sub-accounts, distinct creds from .env) so
# the equity accounts accrue exchange-truth fills too. Runs after the Bybit pull;
# both pullers are fail-soft internally (skip a missing-cred account, exit 2 only
# when ALL creds are missing — a deploy problem worth failing the unit loudly).
ExecStart=/home/ubuntu/ict-trading-bot/.venv/bin/python -u scripts/pull_alpaca_fills.py --all-alpaca-accounts --days 7
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
